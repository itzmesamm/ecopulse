DATABASE_URL=sqlite:///./ecopulse.db
# Swap to your Supabase Postgres connection string once ready, e.g.:
# DATABASE_URL=postgresql://postgres:[email protected]:5432/postgres?sslmode=require
# Find this under Supabase project -> Settings -> Database -> Connection string

# Supabase project -> Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key                  # used by the frontend later
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # backend only, never expose to frontend
