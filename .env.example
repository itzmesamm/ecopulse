DATABASE_URL=sqlite:///./ecopulse.db
APP_ENV=development
INGESTION_MODE=synthetic
SYNTHETIC_RECORD_COUNT=100
# Swap to your Supabase Postgres connection string once ready, e.g.:
# DATABASE_URL=postgresql://postgres:[email protected]:5432/postgres?sslmode=require
# Find this under Supabase project -> Settings -> Database -> Connection string

# Supabase project -> Settings -> API
# Local Postgres auth (no Supabase required)
AUTH_SECRET=change-me-in-production
# Optional local-only smoke test identity; middleware ignores this in production.
DEV_AUTH_TOKEN=local-only-test-token
DEV_AUTH_USER_ID=local-test-user
DEV_AUTH_ORG_ID=local-test-org
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000

# Optional legacy keys (unused by auth now — database is plain Postgres via DATABASE_URL)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# AI recommendation layer (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_TOKENS=64
EMBEDDINGS_ENABLED=true
PIPELINE_RECOMMENDATION_LIMIT=5

# Scheduled collection and remediation are opt-in. Start Celery worker + beat
# after configuring Redis and the corresponding provider credentials.
REDIS_URL=redis://localhost:6379/0
INGESTION_ENABLED=false
PIPELINE_ENABLED=false
REMEDIATION_ENABLED=false
REMEDIATION_DRY_RUN=true
REMEDIATION_ALLOWED_INSTANCE_IDS=
SYSTEM_USER_ROLE=system
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_BEARER_TOKEN=
LOKI_URL=http://localhost:3100
LOKI_BEARER_TOKEN=
LOKI_QUERY={job=~".+"}
LOKI_LOOKBACK_MINUTES=15
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
